# Kong-Rust 开发环境配置
# ========================
# 此文件用于本地开发，生产环境请自行调整。
#
# 配置优先级: 默认值 < 本文件 < KONG_* 环境变量
# 例如 `make dev` 会通过 KONG_PG_PORT 环境变量覆盖 pg_port。

# ---------- 数据库 ----------
database = postgres
pg_host = 127.0.0.1
pg_port = 5432
pg_database = kong
pg_user = kong
pg_password = kong

# ---------- 监听器 ----------
proxy_listen = 0.0.0.0:8000, 0.0.0.0:8443 ssl
admin_listen = 127.0.0.1:8001
status_listen = 127.0.0.1:8007

# ---------- 路由 ----------
router_flavor = traditional

# ---------- 日志 ----------
# 日志级别: debug, info, notice, warn, error, crit
log_level = info

# 错误日志路径（设为 off 禁用文件输出，仅输出到 stderr）
proxy_error_log = logs/error.log

# 访问日志路径（设为 off 禁用）
proxy_access_log = logs/access.log
admin_access_log = logs/admin_access.log
admin_error_log = logs/error.log
status_access_log = off
status_error_log = logs/status_error.log

# ---------- 插件 ----------
plugins = bundled

# ---------- AI 上下文压缩 ----------
# Headroom sidecar/proxy 根地址；保持注释即禁用。生产环境应使用同 Pod loopback、
# 私有网络或保留 Provider Authorization 的 mTLS 边界隔离 sidecar。
#ai_context_compression_headroom_url = http://127.0.0.1:8787
#ai_context_compression_health_timeout_ms = 200
#ai_context_compression_health_ttl_ms = 1000
# 首版未验证共享 CCR store capability，即使配置 cluster 也会保守降级并公布为 local。
#ai_context_compression_store_scope = local

# ---------- AI 预算治理 ----------
# 预算热路径、owner 心跳与管理面使用独立 PostgreSQL 连接池，避免恢复或管理操作
# 挤占请求准入。以下均为默认值；生产环境请按实例并发数和数据库容量调整。
#ai_budget_pg_pool_size = 10
#ai_budget_heartbeat_pg_pool_size = 1
#ai_budget_admin_pg_pool_size = 2
#ai_budget_max_concurrent_ops = 8
#ai_budget_recovery_reserved_ops = 2
#ai_budget_recovery_scan_batch = 100
#ai_budget_operation_timeout_ms = 2000
#ai_budget_lock_timeout_ms = 500
#ai_budget_owner_lease_seconds = 30
#ai_budget_owner_heartbeat_ms = 5000
#ai_budget_intent_stale_grace_seconds = 60
#ai_budget_checkpoint_interval_seconds = 60
#ai_budget_checkpoint_soft_tail_events = 10000
#ai_budget_checkpoint_hard_tail_events = 100000

# ---------- 代理扩展（Nginx 能力对齐） ----------
# 注入代理相关请求头到上游（默认全部注入，与 Kong 一致）
# on = 全部注入（X-Real-IP, X-Forwarded-For/Proto/Host/Port/Path/Prefix）
# off = 不注入
# 也可指定头名列表，只注入指定的头：
#proxy_real_ip_headers = X-Real-IP, X-Forwarded-For, X-Forwarded-Proto

# 隐藏上游返回的 Server 响应头（默认开启）
#proxy_hide_server_header = on

# 自定义注入的响应头，逗号分隔，每项格式为 "Header-Name: Value"
# 示例：注入常用安全头
#proxy_response_headers = Strict-Transport-Security: max-age=31536000; includeSubDomains, X-Frame-Options: DENY, X-Content-Type-Options: nosniff
